# ============================================================
# ELDERLY HEALTHCARE PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/healthcare_db

# --- JWT ---
JWT_ACCESS_SECRET=your_super_secure_access_secret_here
JWT_REFRESH_SECRET=your_super_secure_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Bcrypt ---
BCRYPT_SALT_ROUNDS=12

# --- Nodemailer (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=no-reply@healthcareplatform.com
EMAIL_FROM_NAME=Healthcare Platform

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Rate Limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# --- Client ---
CLIENT_URL=http://localhost:3000
